// Local-safe top-level config (docs/PLAN.md §5.4, D2/D4): no Workers AI binding,
// a local KV id that Miniflare simulates, debug routes on. `vite dev` and
// `vite preview` run this Worker in workerd with no login.
//
// `env.production` is what `pnpm build:prod` (CLOUDFLARE_ENV=production) bakes
// into dist/explorable/wrangler.json for deploys; see docs/DEPLOY.md. Bindings
// and vars are not inherited by named environments, so it lists them all.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "explorable",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "EXPLORABLE_CACHE", "id": "explorable-cache-local" }],
  "vars": { "EXPLORABLE_DEBUG": "1" },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "ai": { "binding": "AI" },
      // Production KV namespace, created with
      // `pnpm exec wrangler kv namespace create EXPLORABLE_CACHE` (docs/DEPLOY.md).
      // Forks: replace this id with your own namespace id.
      "kv_namespaces": [{ "binding": "EXPLORABLE_CACHE", "id": "06957ddddaad40bb86bfa7df7b6edd75" }],
      // 10 uncached explains per 60 s per client IP; cache hits are never limited.
      "ratelimits": [{ "name": "EXPLAIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
      // PROMPT_VERSION is a code constant (worker/plan/prompt.ts), not a var.
      "vars": { "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast", "EXPLORABLE_DEBUG": "0" },
      "observability": { "enabled": true },
      // PR Preview deployments (`wrangler preview`, run by Workers Builds on PRs). Previews inherit
      // no bindings or vars, so this lists what Previews get. No EXPLORABLE_CACHE on purpose: the
      // Worker treats a missing KV binding as a cache miss (worker/cache.ts), so a Preview never
      // reads or writes production cache entries. Its own rate-limit namespace (1101) keeps
      // Preview traffic from sharing production's counters.
      "previews": {
        "ai": { "binding": "AI" },
        "ratelimits": [{ "name": "EXPLAIN_LIMITER", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } }],
        "vars": { "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast", "EXPLORABLE_DEBUG": "0" }
      }
    }
  }
}
