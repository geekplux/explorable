// Local-safe top-level config (docs/PLAN.md §5.4, D2/D4): no Workers AI binding,
// a local KV id that Miniflare simulates, debug routes on. `vite dev` and
// `vite preview` run this Worker in workerd with no login. Production gets its
// own `env.production` block in the deploy phase.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "explorable",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "EXPLORABLE_CACHE", "id": "explorable-cache-local" }],
  "vars": { "EXPLORABLE_DEBUG": "1" },
  "observability": { "enabled": true }
}
