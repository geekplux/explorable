{
  "name": "explorable",
  "version": "0.0.0",
  "private": true,
  "description": "Hard ideas, made clear with figures you can drag: a paper or a blog post as a short read in plain words.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "build": "vite build && node scripts/gen-sw.mjs",
    "build:prod": "CLOUDFLARE_ENV=production vite build && node scripts/gen-sw.mjs",
    "build:kit": "vite build -c vite.kit.config.ts",
    "build:examples": "node scripts/build-examples.mjs",
    "build:images": "node scripts/social-image.mjs",
    "build:pdf": "node scripts/build-pdf.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:skill-page": "node scripts/skill-page.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "types:worker": "wrangler types --strict-vars=false",
    "check:deploy": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@valibot/to-json-schema": "^1",
    "htmlparser2": "12.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "happy-dom": "^21.0.3",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.151.0"
  }
}
