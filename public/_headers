# Workers Static Assets headers: a strict CSP and cache rules. The Worker adds its own
# security headers to /api/* responses (worker/errors.ts). Keep the CSP in sync
# with scripts/flows/csp.mjs. The Google hosts are gtag.js and its hits (src/analytics.ts),
# as Google's CSP guide for Google Analytics 4 lists them.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; style-src 'self'; script-src 'self' https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The sample PDFs keep their names across deploys (`pnpm build:pdf`), so they revalidate after an hour.
/pdf/*
  ! Cache-Control
  Cache-Control: public, max-age=3600
